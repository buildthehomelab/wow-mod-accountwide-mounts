[worldserver]

########################################
# mod-accountwide-mounts
#
# A mount learned by one character is taught to every other character on the same account the
# next time they log in. Class mounts (paladin, warlock, death knight) are never shared.
# Bots are ignored.
########################################

#
#    AccountWideMounts.Enable
#        Description: Master switch.
#        Default:     1
#

AccountWideMounts.Enable = 1

#
#    AccountWideMounts.RespectItemRestrictions
#        Description: Only teach a mount to characters that could use the item it comes from.
#                     Keeps Alliance mounts off Horde characters and the other way round.
#                     0 shares every mount with every character.
#        Default:     1
#

AccountWideMounts.RespectItemRestrictions = 1

#
#    AccountWideMounts.RespectItemRequirements
#        Description: Only teach a mount to characters that meet the level and skill (riding)
#                     the item it comes from asks for. A held-back mount is taught on level-up or
#                     when the character learns riding. 0 ignores them.
#        Default:     1
#

AccountWideMounts.RespectItemRequirements = 1

#
#    AccountWideMounts.IndividualProgression.Enable
#        Description: With mod-individual-progression: a mount whose item vendors only sell from
#                     a progression state on (a vendor condition on the state's quest) waits until
#                     the character reaches that state. Mounts from drops and quests aren't gated.
#        Default:     0
#
#    AccountWideMounts.IndividualProgression.QuestBase
#        Description: The quest id of state 0; IP rewards QuestBase + n when a character reaches
#                     state n.
#        Default:     66000
#
#    AccountWideMounts.IndividualProgression.MaxState
#        Description: The highest state.
#        Default:     18
#

AccountWideMounts.IndividualProgression.Enable = 0
AccountWideMounts.IndividualProgression.QuestBase = 66000
AccountWideMounts.IndividualProgression.MaxState = 18
